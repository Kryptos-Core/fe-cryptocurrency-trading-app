# ============================================================
# Production Environment Configuration - Frontend
# ============================================================
# IMPORTANT: Copy this file to .env on the server/CI
# for production builds.
# ============================================================

# API Configuration - Production Backend URL
# Replace 'yourdomain.com' with your actual domain
BASE_URL=https://api-kryptos-core.maxnoah.io.vn/api/v1

# App environment: production for mainnet, development/sandbox for testnet
ENV=production

# On-chain operator mode: production (mainnet) | sandbox (testnet/devnet)
# Must match backend ONCHAIN_OPERATOR_MODE
ONCHAIN_OPERATOR_MODE=production

# About page URL (policy + user guide)
ABOUT_URL=https://yourdomain.com/about

# App name
APP_NAME=Kryptos Core

# WalletConnect / Reown Project ID (get from https://cloud.walletconnect.com)
# For production, use a separate project from development
REOWN_PROJECT_ID=CHANGE_ME_PRODUCTION_REOWN_PROJECT_ID

# App URLs (optional)
# APP_URL=https://yourdomain.com
# APP_ICON_URL=https://yourdomain.com/icon.png
