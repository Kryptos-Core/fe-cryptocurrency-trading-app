# Copy to .env and set BASE_URL for your setup.
# API Configuration - Backend runs on port 3000 (npm run start:dev).
# Include /api/v1 in BASE_URL.
#
# Where you run the app          | BASE_URL
# -------------------------------|------------------------------------------
# Windows desktop / Chrome       | http://127.0.0.1:3000/api/v1
# Android Emulator               | http://10.0.2.2:3000/api/v1
# iOS Simulator                  | http://localhost:3000/api/v1
# Physical device (same WiFi)    | http://<YOUR_PC_IP>:3000/api/v1
#
# If you see "No pairs configured; price feed not started" in backend logs:
# 1) Login in the app (after fixing BASE_URL).
# 2) Call sync: POST {baseUrl}/exchange/sync-info (e.g. via Swagger: http://localhost:3000/api/docs).
# 3) Restart backend; price feed will then start.
#
BASE_URL=http://127.0.0.1:3000/api/v1
ENV=development
