# API Configuration - Base URL must point to the machine running the backend.
# Include /api/v1 prefix. Backend runs on port 3000 (listen 0.0.0.0).
#
# Pick ONE based on where you run the app:
#   Windows / Chrome (same PC):  BASE_URL=http://127.0.0.1:3000/api/v1
#   Android Emulator:            BASE_URL=http://10.0.2.2:3000/api/v1
#   iOS Simulator:               BASE_URL=http://localhost:3000/api/v1
#   Physical device (same WiFi): BASE_URL=http://<YOUR_PC_IP>:3000/api/v1
#
# Login: POST {baseUrl}/auth/login. If "connection refused", check firewall (port 3000) and backend is running.
# "No pairs configured; price feed not started" → run POST /api/v1/exchange/sync-info (e.g. via Swagger) then restart backend.

BASE_URL=https://api-kryptos-core.maxnoah.io.vn/api/v1

# App environment: legacy fallback for treasury / chain dropdowns when ONCHAIN_OPERATOR_MODE is unset or blank.
#   production — mainnet-only lists; anything else — testnet/devnet lists.
ENV=development

# Khớp backend `ONCHAIN_OPERATOR_MODE` (production | sandbox). Khi đặt giá trị (không để trống), UI ưu tiên key này
# cho dropdown chain (ví vận hành, filter, hot wallet, v.v.) — sandbox → Nile/Shasta/Chapel/devnet; production → mainnet.
# Cũng dùng cho đăng nhập Web (MetaMask/TronLink). Nếu bỏ trống hoàn toàn (không có dòng), UI dùng ENV ở trên.
# ONCHAIN_OPERATOR_MODE=production
ONCHAIN_OPERATOR_MODE=sandbox

# Tron testnet used when creating an ops wallet in sandbox (single "Tron TRC-20 testnet" row). Must match backend TRON_DEFAULT_NETWORK.
# TRON_DEFAULT_NETWORK=TRON_SHASTA

# About page URL (policy + user guide)
ABOUT_URL=https://github.com

# WalletConnect / Reown pairing metadata (optional; defaults keep Reown branding)
APP_NAME=Kryptos Core
# APP_URL=https://your-app.example
# APP_ICON_URL=https://your-cdn.example/icon.png

# Reown / WalletConnect Cloud — phải trùng với backend `REOWN_PROJECT_ID` (xem be-cryptocurrency-trading-app/.env.development).
# FE ưu tiên `REOWN_PROJECT_ID`; fallback `WALLETCONNECT_PROJECT_ID` (xem lib/core/services/wallet_connect/reown_wallet_auth_config.dart).
# Bắt buộc cho Reown AppKit trên Android/iOS. Desktop dùng QR từ BE (/auth/wallet/wc/*) nhưng vẫn nên trùng project.
REOWN_PROJECT_ID=365ec21c61ee9ff11777a3825c74633e
# (fallback) WALLETCONNECT_PROJECT_ID=... nếu không đặt REOWN_PROJECT_ID
