# API Configuration - Base URL must point to the machine running the backend.
# Include /api/v1 prefix. Backend runs on port 3000 (listen 0.0.0.0).
#
# Pick ONE based on where you run the app:
#   Windows / Chrome (same PC):  BASE_URL=http://127.0.0.1:3000/api/v1
#   Android Emulator:            BASE_URL=http://10.0.2.2:3000/api/v1
#   iOS Simulator:               BASE_URL=http://localhost:3000/api/v1
#   Physical device (same WiFi): BASE_URL=http://<YOUR_PC_IP>:3000/api/v1
#
# Login: POST {baseUrl}/auth/login. If "connection refused", check firewall (port 3000) and backend is running.
# "No pairs configured; price feed not started" → run POST /api/v1/exchange/sync-info (e.g. via Swagger) then restart backend.
#
BASE_URL=http://10.0.2.2:3000/api/v1

# Development/Production
ENV=development

# About page URL (policy + user guide)
ABOUT_URL=https://github.com