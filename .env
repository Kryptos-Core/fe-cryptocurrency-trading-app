# API Configuration - Base URL must point to the machine running the backend.
# Include /api/v1 prefix. Backend runs on port 3000.
#
# Pick ONE based on how you run the app:
#
# 1) Windows desktop / Chrome / same PC:
#    BASE_URL=http://127.0.0.1:3000/api/v1
#
# 2) Android Emulator (required - emulator's localhost is not your PC):
#    BASE_URL=http://10.0.2.2:3000/api/v1
#
# 3) Physical phone / tablet on same WiFi (replace with your PC's IP):
#    BASE_URL=http://192.168.1.100:3000/api/v1
#
BASE_URL=http://127.0.0.1:3000/api/v1

# Development/Production
ENV=development